// MARK: - Gua: signing out

/* GUA FORK: replaces upstream's screen_signout_recovery_disabled_* and
   screen_signout_key_backup_disabled_*, which told the user they would need a recovery key to
   restore their chats, and offered a "Settings" button through to the console that generates one. */
"gua_signout_last_device_title" = "Signing out will remove your messages from this device";
"gua_signout_last_device_message" = "Messages kept only here will not be available when you sign back in.";

// MARK: - Gua identity change, other surfaces

/* Shown in place of a message that cannot be decrypted because the sender's encryption identity changed. Replaces upstream's "Sender's verified identity was reset". */
"gua_identity_change_undecryptable" = "This message can’t be opened because the sender’s security details changed.";

/* Shown on a contact's profile when their encryption identity changed. Replaces upstream's "%1$@'s identity was reset." %1$@ is the contact's display name. */
"gua_identity_change_profile" = "%1$@’s security details changed. This can happen when they reinstall Gua or get a new phone.";

// MARK: - Gua: encryption repair banner

/* Banner shown when this device's encryption setup is broken and cannot repair itself.
   Replaces upstream's "Your key storage is out of sync" / "Confirm your recovery key", which
   asked for a recovery key Gua never shows anyone. */
"gua_encryption_repair_title" = "Finish setting up this device";
"gua_encryption_repair_message" = "Complete setup to access encrypted chats and message history available on this device.";
"gua_encryption_repair_action" = "Finish setup";
/* Shown on the same button while the repair is running, so a tap is never silent. */
"gua_encryption_repair_action_in_progress" = "Setting up…";

/* Shown only when the automatic repair could not finish and a reset of the encrypted backup is
   genuinely required. Deliberately names the loss rather than burying it, because the reset is
   irreversible for history that lives only in that backup. */
"gua_encryption_reset_required_title" = "Some previous messages can’t be recovered";
"gua_encryption_reset_required_message" = "To finish setting up encrypted chats on this device, your encrypted backup needs to be reset. Messages stored only in that backup will be lost. Messages already on your devices won’t be affected.";
"gua_encryption_reset_required_action" = "Reset and finish setup";
"gua_encryption_recover_from_other_device_title" = "Restore your previous messages";
"gua_encryption_recover_from_other_device_message" = "Use your other device to restore messages that aren’t available on this device yet.\n\nIf you don’t have access to it, you can reset and finish setup, but messages saved only in your backup will be permanently lost.";
// MARK: - Gua: no homeserver in room-address copy

/* Hint under the "Join room by address" field. Replaces upstream's "e.g. #room-name:matrix.org",
   which named another network's homeserver and taught people the server-qualified form Gua hides. */
"gua_join_room_by_address_hint" = "Paste the room address you were given.";

// MARK: - Gua: finishing an identity reset

/* Modal shown between the approval sheet closing and the setup being confirmed. */
"gua_encryption_reset_finishing" = "Finishing setup…";
/* Toast when the approval sheet was closed without approving. */
"gua_encryption_reset_not_approved" = "Setup wasn’t approved. Tap Reset and finish setup to try again.";
/* Toast when the approval came back but the setup could not be confirmed in time. */
"gua_encryption_reset_failed" = "Couldn’t finish setup. Tap Reset and finish setup to try again.";

