// MARK: - Gua: sign in with a passkey

/* Button on the phone-entry screen. The passkey is a discoverable credential, so it
   identifies the account on its own: choosing this sends no code and costs no message. */
"gua_sign_in_with_passkey" = "Sign in with a passkey";


/* Gua resolver v1 problem codes, surfaced on the phone entry screen */
"gua_resolver_claims_invalid" = "We couldn’t confirm your account details. Please try again.";
"gua_resolver_routing_unavailable" = "We’re having trouble connecting right now. Please try again in a moment.";
