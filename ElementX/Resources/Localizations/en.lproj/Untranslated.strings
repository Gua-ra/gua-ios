/* Toast when the approval sheet was closed without approving. */
"gua_encryption_reset_not_approved" = "Setup wasn’t approved. Please try again.";
/* Toast when the approval came back but the setup could not be confirmed in time. */
"gua_encryption_reset_failed" = "Couldn’t finish setup. Please try again.";
"gua_encryption_reset_still_finishing" = "Still finishing setup in the background. You can keep using Gua.";

