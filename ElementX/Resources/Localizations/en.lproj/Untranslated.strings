/* Used for testing */
"untranslated" = "Untranslated";

// MARK: - Gua identity change banner

/* Shown in a conversation when a contact's encryption identity changed, e.g. after reinstalling the app or moving to a new phone. %1$@ is the contact's display name, %2$@ is replaced with a "Learn more" link. */
"gua_identity_change_banner_description" = "%1$@’s security details changed. This can happen when they reinstall Gua or get a new phone. %2$@";

// MARK: - Soft logout

"soft_logout_signin_title" = "Sign in";
"soft_logout_signin_notice" = "Your homeserver (%1$s) admin has signed you out of your account %2$s (%3$s).";
"soft_logout_signin_e2e_warning_notice" = "Sign in to recover encryption keys stored exclusively on this device. You need them to read all of your secure messages on any device.";
"soft_logout_clear_data_title" = "Clear personal data";
"soft_logout_clear_data_notice" = "Warning: Your personal data (including encryption keys) is still stored on this device.\n\nClear it if you’re finished using this device, or want to sign in to another account.";
"soft_logout_clear_data_submit" = "Clear all data";
"soft_logout_clear_data_dialog_title" = "Clear data";
"soft_logout_clear_data_dialog_content" = "Clear all data currently stored on this device?\nSign in again to access your account data and messages.";

// MARK: - Gua identity change, other surfaces

/* Shown in place of a message that cannot be decrypted because the sender's encryption identity changed. Replaces upstream's "Sender's verified identity was reset". */
"gua_identity_change_undecryptable" = "This message can’t be opened because the sender’s security details changed.";

/* Shown on a contact's profile when their encryption identity changed. Replaces upstream's "%1$@'s identity was reset." %1$@ is the contact's display name. */
"gua_identity_change_profile" = "%1$@’s security details changed. This can happen when they reinstall Gua or get a new phone.";

// MARK: - Gua: no homeserver in room-address copy

/* Hint under the "Join room by address" field. Replaces upstream's "e.g. #room-name:matrix.org",
   which named another network's homeserver and taught people the server-qualified form Gua hides. */
"gua_join_room_by_address_hint" = "Paste the room address you were given.";

// MARK: - Gua: sign in by linking an existing device

/* Button on the phone-entry screen offering to sign in by scanning the code shown on a phone
   that is already signed in, instead of entering a number and waiting for a code. */
"gua_sign_in_with_existing_device" = "Use a device you're already signed in on";
