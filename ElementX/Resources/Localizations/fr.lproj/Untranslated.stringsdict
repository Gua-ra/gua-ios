			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d heure</string>
			<key>other</key>
			<string>%1$d heures</string>
		</dict>
	</dict>
	<key>gua_duration_minutes</key>
