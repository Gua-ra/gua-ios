#!/bin/bash

export PATH="$PATH:/opt/homebrew/bin"

# Prefer the BuildTools pin CI uses: an older Homebrew swiftformat rejects options in .swiftformat.
SWIFTFORMAT=BuildTools/.build/release/swiftformat
[ -x "$SWIFTFORMAT" ] || SWIFTFORMAT=swiftformat

if ! "$SWIFTFORMAT" --lint . > /dev/null 2>&1
then
  echo "pre-commit: Commit aborted due to SwiftFormat warnings. Please check the automatically generated fixes and try again"
  "$SWIFTFORMAT" . > /dev/null 2>&1
  exit 1
fi

./Tools/Scripts/validate_lfs.sh

LOCAL_SCRIPT_PATH="$HOME/.local/elementx_local_dev/pre-commit"
if [ -x "$LOCAL_SCRIPT_PATH" ]; then
	export ELEMENTX_REPO="$(pwd)"
	"$LOCAL_SCRIPT_PATH"
fi
