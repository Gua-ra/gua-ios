{
  "cases": [
    {
      "name": "a chat theme wins over the default",
      "chatTheme": {
        "v": 1,
        "kind": "preset",
        "preset": "ocean",
        "bubble": "teal"
      },
      "defaultTheme": {
        "v": 1,
        "kind": "preset",
        "preset": "sunset",
        "bubble": "pink"
      },
      "roomIsPrivate": false,
      "mediaShown": true,
      "expected": {
        "kind": "preset",
        "preset": "ocean",
        "bubble": "teal"
      }
    },
    {
      "name": "no chat theme shows the default",
      "chatTheme": {},
      "defaultTheme": {
        "v": 1,
        "kind": "preset",
        "preset": "sunset",
        "bubble": "pink"
      },
      "roomIsPrivate": false,
      "mediaShown": true,
      "expected": {
        "kind": "preset",
        "preset": "sunset",
        "bubble": "pink"
      }
    },
    {
      "name": "neither theme shows stock",
